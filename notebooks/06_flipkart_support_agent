# FAISS search
# ---------------------------------------------------------------------------
# Helper: FAISS retrieval
# ---------------------------------------------------------------------------

def retrieve_chunks(query: str, k: int = 3):
    """Embed the query, search FAISS index, return top-k chunks with scores."""
    query_emb = model.encode([query], convert_to_numpy=True)
    faiss.normalize_L2(query_emb)
    D, I = index.search(query_emb, k)
    results = []
    for rank, idx in enumerate(I[0]):
        cid = chunk_ids[idx]
        results.append({
            "doc_id": chunk_to_doc[cid],
            "text": chunk_id_to_text[cid],
            "score": float(D[0][rank])
        })
    return results


#load return risk model from task 1
def check_return_risk(order_features: dict) -> dict:
    row_df = pd.DataFrame([order_features])
    proba = pipeline.predict_proba(row_df)[:, 1][0]

    if proba < t_star_rf:
        bucket = "Low"
    elif proba >= t_star_rf + 0.15:
        bucket = "High"
    else:
        bucket = "Medium"

    return {
        "return_probability": float(proba),
        "risk_bucket": bucket,
    }

