import faiss
import numpy as np
import joblib
import pandas as pd
import torch 
import torch.nn as nn
from torchvision import models, transforms
from PIL import Image
import os

#artifact
artifact = joblib.load("./models/return_risk_model.pkl")
print(artifact["t_star_rf"])
print(type(artifact["model"]))
pipeline= artifact["model"]
t_star_rf= artifact["t_star_rf"]

#path
document_path = "data/policy_knowledgebase.json"
index_path = "data/policy_index.faiss"
metadata_path = "data/policy_chunks.json"

#loads document
with open(document_path, "r") as f:
    kb = json.load(f)

documents = kb["documents"]

#chunking documents and mapping to source doc
chunks = []
chunk_ids = []
chunk_to_doc = {}
chunk_id_to_text = {}

for doc in documents:
    for i, chunk in enumerate(doc["chunks"]):
        chunk_id= f"{doc['doc_id']}_c{i}"
        chunks.append(chunk)
        chunk_ids.append(chunk_id)
        chunk_to_doc[chunk_id] = doc["doc_id"]
        chunk_id_to_text[chunk_id] = chunk

#embedding
model= SentenceTransformer("all-MiniLM-L6-v2", cache_folder= "./models")
embeddings = model.encode(chunks,convert_to_numpy=True)

#normalise for cosine similarity
faiss.normalize_L2(embeddings)

#vector indexing with faiss
dimension= embeddings.shape[1]
index= faiss.IndexFlatIP(dimension)
index.add(np.array(embeddings))
faiss.write_index(index, index_path)

#chunk text and id map dict along index
metadata = {
    "chunk_ids": chunk_ids,
    "chunk_to_doc": chunk_to_doc,
    "chunk_id_to_text": chunk_id_to_text,
}
with open(metadata_path, "w") as f:
    json.dump(metadata, f, indent=2)

#query test
query = "How long does COD refund take?"
query_emb = model.encode([query], convert_to_numpy=True)
faiss.normalize_L2(query_emb)

# FAISS search
D, I = index.search(query_emb, k=3)
for rank,idx in enumerate(I[0]):
    cid = chunk_ids[idx]
    print(f"{rank+1}. {cid} → doc {chunk_to_doc[cid]} (score={D[0][rank]:.4f})")
    print(f"   text: {chunk_id_to_text[cid][:150]}...")


#load return risk model from task 1
def check_return_risk(order_features: dict) -> dict:
    row_df = pd.DataFrame([order_features])
    proba = pipeline.predict_proba(row_df)[:, 1][0]

    if proba < t_star_rf:
        bucket = "Low"
    elif proba >= t_star_rf + 0.15:
        bucket = "High"
    else:
        bucket = "Medium"

    return {
        "return_probability": float(proba),
        "risk_bucket": bucket,
    }

df = pd.read_csv("data/orders_dataset.csv")
sample_row = df.drop(columns=["order_id", "returned"]).iloc[0].to_dict()

print(check_return_risk(sample_row))

# --- module-level setup, run once ---
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

num_features = 1280  

head = nn.Sequential(
    nn.Linear(num_features, 128),
    nn.ReLU(),
    nn.Dropout(0.3),
    nn.Linear(128, 10)
)
class ProductClassifier(nn.Module):
    def __init__(self, head_module):
        super().__init__()
        backbone = torchvision.models.efficientnet_b0(
            weights=torchvision.models.EfficientNet_B0_Weights.IMAGENET1K_V1
        )
        for param in backbone.parameters():
            param.requires_grad = False
        backbone.classifier = nn.Identity()
        self.backbone = backbone
        self.head = head_module

    def forward(self, x):
        features = self.backbone(x)
        return self.head(features)
    
state_dict = torch.load('models/product_classifier.pt', map_location=device)
classifier = ProductClassifier(head)
classifier.load_state_dict(state_dict)
classifier.eval()
classifier.to(device)

class_names = [
    "T-shirt/top", "Trouser", "Pullover", "Dress", "Coat",
    "Sandal", "Shirt", "Sneaker", "Bag", "Ankle boot"
]

predict_transform = torchvision.transforms.Compose([
    torchvision.transforms.Grayscale(num_output_channels=3),
    torchvision.transforms.Resize((224, 224)),
    torchvision.transforms.ToTensor(),
    torchvision.transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                      std=[0.229, 0.224, 0.225]),
])

# --- the actual tool function ---
def classify_product_image(image_path: str) -> dict:
    image = Image.open(image_path)
    tensor = predict_transform(image).unsqueeze(0).to(device)

    with torch.no_grad():
        logits = classifier(tensor)
        probs = torch.softmax(logits, dim=1)
        confidence, pred_idx = torch.max(probs, dim=1)

    return {
        "predicted_label": class_names[pred_idx.item()],
        "confidence": float(confidence.item()),
    }


#sample-image test loop 
for fname in os.listdir("data/sample_images"):
    result = classify_product_image(os.path.join("data/sample_images", fname))
    print(fname, "→", result)

#retrieval evaluation
#query test

eval_queries = kb["retrieval_eval"]["queries"]

precisions = []
recalls = []

for item in eval_queries:
    query = item["query"]
    relevant_docs = set(item["relevant_docs"])

    query_emb = model.encode([query], convert_to_numpy=True)
    faiss.normalize_L2(query_emb)

    D, I = index.search(query_emb, k=3)

    retrieved_doc_ids = []
    for idx in I[0]:
        cid = chunk_ids[idx]
        doc_id = chunk_to_doc[cid]
        if doc_id not in retrieved_doc_ids:
            retrieved_doc_ids.append(doc_id)

    hits = [d for d in retrieved_doc_ids if d in relevant_docs]

    precision_at_3 = len(hits) / 3
    recall_at_3 = len(hits) / len(relevant_docs)

    precisions.append(precision_at_3)
    recalls.append(recall_at_3)

    print(f"Query: {query!r}")
    print(f"  Retrieved docs (top-3, deduped): {retrieved_doc_ids}")
    print(f"  Relevant docs:                   {sorted(relevant_docs)}")
    print(f"  Hits: {hits}  ->  Precision@3 = {len(hits)}/3 = {precision_at_3:.3f}, "
          f"Recall@3 = {len(hits)}/{len(relevant_docs)} = {recall_at_3:.3f}")
    print()

avg_precision = sum(precisions) / len(precisions)
avg_recall = sum(recalls) / len(recalls)

print(f"Average Precision@3: {avg_precision:.3f}")
print(f"Average Recall@3:    {avg_recall:.3f}")
